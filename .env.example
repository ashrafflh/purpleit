# ============================================================
# PurpleStrike — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Target System Credentials ---
PURPLESTRIKE_TARGET_AD_DOMAIN=corp.local
PURPLESTRIKE_TARGET_USERNAME=attack_user
PURPLESTRIKE_TARGET_PASSWORD=
PURPLESTRIKE_WINRM_TRANSPORT=kerberos

# --- Target Groups (JSON) ---
# Dictionary keyed by group name, each with name, domain, industry, and hosts list.
# Each host: hostname, ip, os (windows/linux), asset_type (domain_controller/critical_server/standard_server/workstation), domain
PURPLESTRIKE_TARGET_GROUPS={"corp.local":{"name":"corp.local","domain":"corp.local","industry":"technology","hosts":[{"hostname":"dc-01","ip":"192.168.1.10","os":"windows","asset_type":"domain_controller","domain":"corp.local"}]}}

# --- Wazuh SIEM ---
PURPLESTRIKE_WAZUH_API_URL=https://wazuh-manager:55000
PURPLESTRIKE_WAZUH_API_USER=purplestrike
PURPLESTRIKE_WAZUH_API_PASSWORD=
PURPLESTRIKE_WAZUH_API_TIMEOUT=30

# --- LLM Provider ---
# Options: openai, deepseek, anthropic, ollama, vllm, nvidia
PURPLESTRIKE_LLM_PROVIDER=openai

# --- OpenAI ---
PURPLESTRIKE_OPENAI_API_KEY=
PURPLESTRIKE_OPENAI_MODEL=gpt-4o

# --- DeepSeek ---
PURPLESTRIKE_DEEPSEEK_API_KEY=
PURPLESTRIKE_DEEPSEEK_BASE_URL=https://api.deepseek.com
PURPLESTRIKE_DEEPSEEK_MODEL=deepseek-chat
# In config.yaml, set llm.extra.thinking=disabled for planning-style JSON responses.

# --- Anthropic ---
PURPLESTRIKE_ANTHROPIC_API_KEY=
PURPLESTRIKE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Ollama (local) ---
PURPLESTRIKE_OLLAMA_BASE_URL=http://localhost:11434
PURPLESTRIKE_OLLAMA_MODEL=llama3

# --- vLLM (local) ---
PURPLESTRIKE_VLLM_BASE_URL=http://localhost:8000
PURPLESTRIKE_VLLM_MODEL=

# --- NVIDIA (free API at build.nvidia.com) ---
PURPLESTRIKE_NVIDIA_API_KEY=
PURPLESTRIKE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
PURPLESTRIKE_NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- Database ---
PURPLESTRIKE_DB_PATH=

# --- C2 Frameworks (Optional) ---
PURPLESTRIKE_SLIVER_OPERATOR_TOKEN=
PURPLESTRIKE_CALDERA_API_KEY=
