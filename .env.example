# ============================================================
# PurpleStrike — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Target System Credentials ---
PURPLESTRIKE_TARGET_AD_DOMAIN=purple.local
PURPLESTRIKE_TARGET_USERNAME=achraf.flah@purple.local
PURPLESTRIKE_TARGET_PASSWORD=PWD
PURPLESTRIKE_WINRM_TRANSPORT=ntlm

# --- Agentless Connection Selection ---
# auto: Windows -> winrm (existing behavior), Linux -> ssh
# Windows options: winrm, winrm_nonadmin, ssh, wmi
# Hosts in TARGET_GROUPS may override with "connection_method":"ssh".
PURPLESTRIKE_CONNECTION_METHOD=auto
PURPLESTRIKE_CONNECT_TIMEOUT=15
# Optional: http://{host}:5985/wsman or https://{host}:5986/wsman
PURPLESTRIKE_WINRM_ENDPOINT=
# Existing lab behavior is ignore; use validate with trusted HTTPS certificates.
PURPLESTRIKE_WINRM_CERT_VALIDATION=ignore

# Optional per-mode credentials. When a mode username is supplied, also supply
# its password (or SSH keys); the common admin password is not reused.
PURPLESTRIKE_WINRM_NONADMIN_USERNAME=
PURPLESTRIKE_WINRM_NONADMIN_PASSWORD=
PURPLESTRIKE_WINRM_NONADMIN_DOMAIN=
PURPLESTRIKE_SSH_USERNAME=
PURPLESTRIKE_SSH_PASSWORD=
PURPLESTRIKE_SSH_DOMAIN=
PURPLESTRIKE_SSH_PORT=22
# Empty uses normal OpenSSH known_hosts. Explicit 'none' is a lab-only opt-out.
PURPLESTRIKE_SSH_KNOWN_HOSTS=
PURPLESTRIKE_SSH_CLIENT_KEYS=[]

# WMI uses native Windows WMI/DCOM; requires a Windows controller and SMB output.
PURPLESTRIKE_WMI_USERNAME=
PURPLESTRIKE_WMI_PASSWORD=
PURPLESTRIKE_WMI_DOMAIN=
# Defaults below suit admin mode. For delegated access use a dedicated share:
# PurpleStrikeTransport$, '.', C:\ProgramData\PurpleStrike\Transport
PURPLESTRIKE_WMI_SHARE=ADMIN$
PURPLESTRIKE_WMI_SHARE_PATH=Temp
PURPLESTRIKE_WMI_REMOTE_PATH=C:\Windows\Temp

# --- Target Groups (JSON) ---
# Dictionary keyed by group name, each with name, domain, industry, and hosts list.
# Each host: hostname, ip, os (windows/linux), asset_type (domain_controller/critical_server/standard_server/workstation), domain
PURPLESTRIKE_TARGET_GROUPS={"purple.local":{"name":"purple.local","domain":"purple.local","industry":"technology","hosts":[{"hostname":"10.10.1.107","ip":"10.10.1.107","os":"windows","asset_type":"workstation","domain":"purple.local"}]}}

# --- Wazuh SIEM ---
PURPLESTRIKE_WAZUH_API_URL=https://10.10.1.106:55000
PURPLESTRIKE_WAZUH_API_USER=admin
PURPLESTRIKE_WAZUH_API_PASSWORD=PWD
PURPLESTRIKE_WAZUH_API_TIMEOUT=30

# --- LLM Provider ---
# Options: openai, anthropic, ollama, vllm, nvidia
PURPLESTRIKE_LLM_PROVIDER=nvidia

# --- OpenAI ---
PURPLESTRIKE_OPENAI_API_KEY=
PURPLESTRIKE_OPENAI_MODEL=gpt-4o

# --- Anthropic ---
PURPLESTRIKE_ANTHROPIC_API_KEY=
PURPLESTRIKE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Ollama (local) ---
PURPLESTRIKE_OLLAMA_BASE_URL=http://localhost:11434
PURPLESTRIKE_OLLAMA_MODEL=llama3

# --- vLLM (local) ---
PURPLESTRIKE_VLLM_BASE_URL=http://localhost:8000
PURPLESTRIKE_VLLM_MODEL=

# --- NVIDIA (free API at build.nvidia.com) ---
PURPLESTRIKE_NVIDIA_API_KEY=
PURPLESTRIKE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
PURPLESTRIKE_NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- Database ---
PURPLESTRIKE_DB_PATH=

# --- C2 Frameworks (Optional) ---
PURPLESTRIKE_SLIVER_OPERATOR_TOKEN=
PURPLESTRIKE_CALDERA_API_KEY=
