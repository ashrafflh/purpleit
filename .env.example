# ============================================================
# PurpleStrike — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Target System Credentials ---
PURPLESTRIKE_TARGET_AD_DOMAIN=corp.local
PURPLESTRIKE_TARGET_USERNAME=attack_user
PURPLESTRIKE_TARGET_PASSWORD=

# --- Wazuh SIEM ---
PURPLESTRIKE_WAZUH_API_URL=https://wazuh-manager:55000
PURPLESTRIKE_WAZUH_API_USER=purplestrike
PURPLESTRIKE_WAZUH_API_PASSWORD=
PURPLESTRIKE_WAZUH_API_TIMEOUT=30

# --- LLM Provider ---
# Options: openai, anthropic, ollama, vllm
PURPLESTRIKE_LLM_PROVIDER=openai

# --- OpenAI ---
PURPLESTRIKE_OPENAI_API_KEY=
PURPLESTRIKE_OPENAI_MODEL=gpt-4o

# --- Anthropic ---
PURPLESTRIKE_ANTHROPIC_API_KEY=
PURPLESTRIKE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Ollama (local) ---
PURPLESTRIKE_OLLAMA_BASE_URL=http://localhost:11434
PURPLESTRIKE_OLLAMA_MODEL=llama3

# --- vLLM (local) ---
PURPLESTRIKE_VLLM_BASE_URL=http://localhost:8000
PURPLESTRIKE_VLLM_MODEL=

# --- Database ---
PURPLESTRIKE_DB_PATH=

# --- C2 Frameworks (Optional) ---
PURPLESTRIKE_SLIVER_OPERATOR_TOKEN=
PURPLESTRIKE_CALDERA_API_KEY=
